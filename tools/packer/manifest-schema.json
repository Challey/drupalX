{
  "schema_version": 1,
  "spec": "DX-PACK-MANIFEST",
  "updated": "2026-08-30",
  "title": "X 出包清单三端统一 schema（L3 Phase H4）",
  "rules": {
    "id_field": "app_id 为规范键；id 为历史别名（flutter 清单沿用），校验器与打包脚本都接受，输出一律按 app_id",
    "unknown_fields": "warn（出包契约向后兼容，不因新增运营字段而失败）",
    "missing_required": "error",
    "defaults": "本文件 default 即「今天线上行为」；打包脚本在清单缺项时使用同一默认值",
    "secret_fields": "bearer_token / token 只允许出现在打包注入参数，不写进清单文件"
  },
  "common_fields": {
    "app_id": {
      "type": "string",
      "required": true,
      "aliases": ["id"],
      "pattern": "^[a-z][a-z0-9_]{1,62}$",
      "desc": "应用机名，与文件名 <app_id>.manifest.yml、App Store catalog machine_name 一致"
    },
    "label": {
      "type": "string",
      "required": true,
      "desc": "人读名称（交付单、打包日志）"
    },
    "brand_name": {
      "type": "string",
      "default": "=label",
      "desc": "端上显示名；缺省等于 label"
    },
    "project_name": {
      "type": "string",
      "default": "=app_id",
      "desc": "工程目录名（Android rootProject.name / 小程序 projectname）"
    },
    "notes": {
      "type": "string",
      "desc": "运营备注，不参与生成"
    }
  },
  "platforms": {
    "android": {
      "packer": "scripts/x-pack-android.sh",
      "apps_dir": "tools/android-packer/apps",
      "manifest_glob": "*.manifest.yml",
      "list_output": "Registered X Android apps:",
      "validate_flag": "--validate --app=<id>",
      "fields": {
        "application_id": {
          "type": "string",
          "required": true,
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "desc": "Android applicationId；已上架应用不得改动（升级安装依赖它）"
        },
        "start_url": {
          "type": "string",
          "required": true,
          "pattern": "^https://",
          "desc": "WebView 首屏；仅 HTTPS"
        },
        "allowed_host": {
          "type": "string",
          "default": "=host(start_url)",
          "desc": "WebView 内允许的主机（含其子域）；其余外链走系统浏览器"
        },
        "version_code": {
          "type": "integer",
          "default": 1,
          "desc": "Android versionCode，只增不减"
        },
        "version_name": {
          "type": "string",
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "desc": "应用版本（交付客户的那个号），与 shell_version 独立"
        },
        "shell_version": {
          "type": "string",
          "default": "1.3.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "desc": "WebView 壳（tools/android-packer/template）模板版本；1.3.0 起支持支付白名单可配置与能力开关"
        },
        "capabilities": {
          "type": "list<string>",
          "default": ["location", "microphone", "photo_upload"],
          "enum": ["location", "microphone", "photo_upload"],
          "unique": true,
          "desc": "壳内已实现的原生能力；默认三项 = 今天线上行为"
        },
        "payment_hosts": {
          "type": "list<host_rule>",
          "default": [
            {"host": "wx.tenpay.com", "match": "exact"},
            {"host": "tenpay.com", "match": "child"},
            {"host": "pay.weixin.qq.com", "match": "domain"},
            {"host": "open.weixin.qq.com", "match": "exact"},
            {"host": "alipay.com", "match": "contains"},
            {"host": "alipayobjects.com", "match": "contains"}
          ],
          "desc": "允许留在 WebView 内的支付/授权域名；默认值等于 1.2.x 的硬编码集合"
        },
        "payment_schemes": {
          "type": "list<string>",
          "default": ["weixin", "wechat", "alipays", "alipay"],
          "unique": true,
          "desc": "交给系统（支付 App）处理的 scheme；其余外链走系统浏览器"
        },
        "permission_rationales": {
          "type": "map<string,string>",
          "default": {},
          "keys_enum": ["location", "microphone", "photo"],
          "desc": "授权说明文案覆盖；不填即用模板 strings.xml 的现网文案"
        }
      }
    },
    "miniprogram": {
      "packer": "scripts/x-pack-miniprogram.sh",
      "apps_dir": "tools/miniprogram-packer/apps",
      "manifest_glob": "*.manifest.yml",
      "list_output": "Registered X mini-program apps:",
      "validate_flag": "--validate --app=<id>",
      "fields": {
        "source": {
          "type": "string",
          "default": "",
          "desc": "小程序源码目录（绝对路径或相对仓库根）；空则走 source_fallback"
        },
        "source_fallback": {
          "type": "list<string>",
          "default": [],
          "desc": "按序尝试的源码目录候选"
        },
        "appid": {
          "type": "string",
          "default": "touristappid",
          "pattern": "^(touristappid|wx[0-9a-f]{16})$",
          "desc": "微信小程序 AppID；未注册时用 touristappid"
        },
        "config": {
          "type": "map",
          "default": {},
          "keys": {
            "apiBase": {"type": "string", "default": "", "desc": "DrupalX 站点根 URL（HTTPS）"},
            "trafficApiBase": {"type": "string", "default": "", "desc": "Traffic API 根；留空表示同源"},
            "clientId": {"type": "string", "default": "", "desc": "渠道/client 标识，用于埋点与登录"}
          },
          "desc": "注入 config.js 的键值"
        },
        "pages_required": {
          "type": "list<string>",
          "default": [],
          "desc": "出包前必须存在的页面路径（不含扩展名）"
        }
      }
    },
    "flutter": {
      "packer": "scripts/x-pack-flutter.sh",
      "apps_dir": "tools/flutter-packer/apps",
      "manifest_glob": "*.manifest.yml",
      "list_output": "Registered X Flutter apps:",
      "validate_flag": "--validate --app=<id>",
      "fields": {
        "app_id": {
          "type": "string",
          "required": true,
          "aliases": ["id"],
          "desc": "与文件名一致；历史清单用 id，二者等价"
        },
        "application_id": {
          "type": "string",
          "default": "com.drupalx.<app_id>",
          "desc": "Android applicationId（flutter create 时用）"
        },
        "bundle_id": {
          "type": "string",
          "default": "=application_id",
          "desc": "iOS bundle identifier"
        },
        "display_name": {
          "type": "string",
          "default": "=label",
          "desc": "桌面显示名"
        },
        "layout_profile": {
          "type": "string",
          "default": "gov_default",
          "enum": ["gov_default", "ent_default"],
          "desc": "服务端 AppLayoutRepository 的布局档案"
        },
        "shell_version": {
          "type": "string",
          "default": "1.0.0",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "desc": "注入 assets/config/shell.json 的壳版本，与 L1 min_shell_version 协商"
        },
        "catalog_version": {
          "type": "integer",
          "default": 2,
          "desc": "组件目录版本；与 clients/flutter_shell/assets/config/component_catalog.json 的 schema_version 对齐"
        }
      }
    }
  },
  "types": {
    "host_rule": {
      "host": {"type": "string", "required": true, "pattern": "^[a-z0-9][a-z0-9.-]*[a-z0-9]$"},
      "match": {
        "type": "string",
        "default": "domain",
        "enum": ["exact", "domain", "child", "contains"],
        "desc": "exact=仅该主机；domain=该主机及其子域；child=仅子域（不含主机本身）；contains=主机串含该片段"
      }
    }
  }
}
