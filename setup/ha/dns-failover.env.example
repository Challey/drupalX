# Install on B as /root/dx-dns-failover.env with mode 600.
# The Aliyun CLI profile must use a least-privilege RAM identity that can read
# and update only the required DNS records.
A_HEALTH_URL=http://172.16.34.121/healthz
A_PUBLIC_IP=198.51.100.11
B_PUBLIC_IP=198.51.100.12
HEALTH_HOST=www.drupal.org.cn
DOMAIN_NAME=drupal.org.cn

# Keep every public DrupalX hostname together during failover.
RR_LIST="www @ x"
TYPE=A
# Current Aliyun DNS plan minimum. Lower values require a different plan.
TTL=600

# Three consecutive 15-second checks avoid switching on a single lost packet.
FAIL_THRESHOLD=3
RECOVERY_THRESHOLD=3
CONNECT_TIMEOUT=3
MAX_TIME=5

STATUS_FILE=/var/lib/dx-ha/dns-state
LOG_FILE=/var/log/dx-dns-failover.log
LOCK_FILE=/run/lock/dx-dns-failover.lock

# Optional: fixed IDs avoid DescribeDomainRecords. Order must match RR_LIST.
# RECORD_IDS="www-record-id apex-record-id x-record-id"
