# DrupalX local MySQL (copy to .env — never commit .env)
DCN_DB_HOST=192.168.16.1
DCN_DB_HOST_FALLBACK=127.0.0.1
DCN_DB_PORT=3306
DCN_DB_USER=root
DCN_DB_PASS=
DCN_DB_PLATFORM=dcn_platform
DCN_DB_PREFIX=dcn_tenant_

# Site URLs
DCN_PLATFORM_HOST=platform.drupalx.local
DCN_TENANT_SUFFIX=drupalx.local

# Admin account created by bootstrap
DCN_ADMIN_USER=admin
DCN_ADMIN_PASS=admin
DCN_ADMIN_MAIL=admin@drupalx.local
