# DrupalX local MySQL (copy to .env — never commit .env)
DX_DB_HOST=192.168.16.1
DX_DB_HOST_FALLBACK=127.0.0.1
DX_DB_PORT=3306
DX_DB_USER=root
DX_DB_PASS=
DX_DB_PLATFORM=dx_platform
DX_DB_PREFIX=dx_tenant_

# Site URLs
DX_PLATFORM_HOST=platform.drupalx.local
DX_TENANT_SUFFIX=drupalx.local

# Admin account created by bootstrap
DX_ADMIN_USER=admin
DX_ADMIN_PASS=admin
DX_ADMIN_MAIL=admin@drupalx.local

# AI gateway platform-default keys (optional; each tenant can override in its site State)
DX_AI_OPENAI_KEY=
DX_AI_DEEPSEEK_KEY=
DX_AI_QWEN_KEY=
DX_AI_ZHIPU_KEY=
