<view class="page">
  <view class="hero" wx:if="{{!error}}">{{title}}</view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <view class="empty" wx:if="{{!error && blocks.length === 0}}">暂无内容模块</view>

  <block wx:for="{{blocks}}" wx:key="type" wx:for-item="block">
    <view class="block" wx:if="{{block.type === 'hero_banner'}}">
      <view class="banner">{{title}}</view>
    </view>
    <view class="block" wx:elif="{{block.type === 'notice_ticker'}}">
      <view class="ticker">通知公告（L2 待接）</view>
    </view>
    <view class="block" wx:elif="{{block.type === 'article_list' || block.type === 'notice_list'}}">
      <view class="section-title">{{block.type === 'notice_list' ? '公告' : '资讯'}}</view>
      <view class="item">条目示例 · Channel L2</view>
    </view>
    <view class="block" wx:elif="{{block.type === 'product_grid'}}">
      <view class="section-title">产品</view>
      <view class="item">产品网格 · Channel L2</view>
    </view>
    <view class="block" wx:elif="{{block.type === 'service_grid'}}">
      <view class="section-title">服务</view>
      <view class="chips">办事 · 预约 · 公开</view>
    </view>
    <view class="block" wx:elif="{{block.type === 'profile_header'}}">
      <view class="section-title">组织名片</view>
    </view>
    <view class="block" wx:elif="{{block.type === 'content' || block.type === 'rich_html'}}">
      <view class="section-title">正文</view>
      <view class="content">{{block.props.html}}{{block.props.body}}</view>
    </view>
    <view class="block" wx:elif="{{block.type === 'web_link'}}">
      <view class="section-title">{{block.props.title || '外链'}}</view>
      <view class="item">{{block.props.url}}</view>
    </view>
    <view class="block" wx:elif="{{block.type === 'article_detail'}}">
      <view class="section-title">{{block.props.title}}</view>
      <view class="item">{{block.props.published_at}}</view>
      <view class="content">{{block.props.summary}}</view>
      <view class="meta">{{block.props.id}}</view>
    </view>
    <view class="block" wx:elif="{{block.type === 'notice_detail'}}">
      <view class="section-title">公告 · {{block.props.title}}</view>
      <view class="item">{{block.props.published_at}}</view>
      <view class="content">{{block.props.summary}}</view>
      <view class="meta">{{block.props.id}}</view>
    </view>
    <view class="block" wx:elif="{{block.type === 'product_detail'}}">
      <view class="section-title">{{block.props.title}}</view>
      <view class="price">{{block.props.price.currency}} {{block.props.price.amount}}</view>
      <view class="meta">SKU {{block.props.sku}}</view>
    </view>
    <view class="block" wx:elif="{{block.type === 'search_bar'}}">
      <view class="search">{{block.props.placeholder || '搜索'}}</view>
    </view>
    <view class="block" wx:elif="{{block.type === 'quick_actions'}}">
      <view class="section-title">{{block.props.title || '快捷入口'}}</view>
      <view class="chips">
        <text class="chip" wx:for="{{block.props.items}}" wx:for-item="action" wx:key="label">{{action.label}}</text>
      </view>
    </view>
    <view class="block" wx:elif="{{block.type === 'nearby_service'}}">
      <view class="section-title">{{block.props.title || '附近服务'}} · {{block.props.radius_km}}km</view>
      <view class="item">开启定位后按距离排序</view>
    </view>
  </block>

  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="id"
      class="tab {{tabIndex === index ? 'on' : ''}}"
      data-index="{{index}}"
      bindtap="onTab"
    >{{item.label}}</view>
  </view>
</view>
