.page { padding: 24rpx 24rpx 140rpx; background: #f5f6f8; min-height: 100vh; }
.hero { font-size: 40rpx; font-weight: 700; color: #1a365d; margin-bottom: 24rpx; }
.banner { background: linear-gradient(135deg,#1a365d,#2c5282); color: #fff; padding: 48rpx 32rpx; border-radius: 24rpx; }
.ticker { background: #edf2f7; padding: 20rpx; border-radius: 12rpx; }
.block { margin-bottom: 24rpx; }
.section-title { font-weight: 600; margin-bottom: 12rpx; }
.item, .chips { background: #fff; padding: 24rpx; border-radius: 12rpx; }
.tabs { position: fixed; left: 0; right: 0; bottom: 0; display: flex; background: #fff; border-top: 1px solid #e2e8f0; }
.tab { flex: 1; text-align: center; padding: 20rpx 0; font-size: 24rpx; color: #4a5568; }
.tab.on { color: #1a365d; font-weight: 600; }
.error { color: #c53030; padding: 24rpx; }
.empty { color: #718096; padding: 48rpx 24rpx; text-align: center; }
.content { background: #fff; padding: 24rpx; border-radius: 12rpx; color: #2d3748; }
.meta { color: #718096; font-size: 22rpx; margin-top: 8rpx; }
.price { color: #1a365d; font-weight: 600; font-size: 34rpx; }
.search { background: #fff; padding: 20rpx 24rpx; border-radius: 12rpx; color: #718096; }
.chip { display: inline-block; margin: 0 12rpx 12rpx 0; background: #edf2f7; padding: 16rpx 24rpx; border-radius: 999rpx; }
