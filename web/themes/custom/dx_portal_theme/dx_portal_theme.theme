<?php

/**
 * @file
 * DrupalX Portal theme hooks.
 */

declare(strict_types=1);

use Drupal\Core\Access\CsrfRequestHeaderAccessCheck;
use Drupal\Core\Url;

/**
 * Implements hook_preprocess_html().
 */
function dx_portal_theme_preprocess_html(array &$variables): void {
  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $variables['attributes']['class'][] = 'path-frontpage';
  }
  $route = \Drupal::routeMatch()->getRouteName();
  if ($route === 'dx_ai_gateway.chat_page') {
    $variables['attributes']['class'][] = 'path-ai-chat';
  }
  if ($route === 'user.login') {
    $title = t('Sign In');
    $variables['head_title']['title'] = $title;
    if (isset($variables['head_title_array']['title'])) {
      $variables['head_title_array']['title'] = $title;
    }
  }
}

/**
 * Implements hook_preprocess_field().
 * Hide field labels for dx_product body (official announcements).
 */
function dx_portal_theme_preprocess_field(array &$variables): void {
  // Check if this is a body field on a dx_product node
  if ($variables['field_name'] === 'body') {
    $entity = $variables['element']['object'] ?? $variables['element']['#object'] ?? NULL;
    if ($entity && method_exists($entity, 'bundle') && $entity->bundle() === 'dx_product') {
      $variables['label_hidden'] = TRUE;
    }
  }
}

/**
 * Implements hook_page_attachments().
 *
 * Attaches login assets outside CSS/JS aggregation so compact login keeps
 * working when theme libraries are dropped from aggregate bundles.
 */
function dx_portal_theme_page_attachments(array &$attachments): void {
  $route = \Drupal::routeMatch()->getRouteName();
  if ($route !== 'user.login') {
    return;
  }
  $attachments['#attached']['library'][] = 'dx_portal_theme/login';
}

/**
 * Implements hook_preprocess_page().
 */
function dx_portal_theme_preprocess_page(array &$variables): void {
  $variables['site_name'] = \Drupal::config('system.site')->get('name') ?: 'DrupalX';
  $variables['site_slogan'] = \Drupal::config('system.site')->get('slogan') ?: '';
  $variables['is_front'] = \Drupal::service('path.matcher')->isFrontPage();
  $variables['#attached']['library'][] = 'dx_portal_theme/global';

  // Build language dropdown data with native names and flags.
  $languages = [];
  $langMeta = [
    'en' => ['name' => 'English', 'flag' => "\u{1F1FA}\u{1F1F8}"],
    'zh-hans' => ['name' => '简体中文', 'flag' => "\u{1F1E8}\u{1F1F3}"],
    'zh-hant' => ['name' => '繁體中文', 'flag' => "\u{1F1E8}\u{1F1F3}"],
  ];
  $variables['active_flag'] = '';
  $variables['active_name'] = '';
  if (\Drupal::moduleHandler()->moduleExists('language')) {
    $languageManager = \Drupal::languageManager();
    $currentLang = $languageManager->getCurrentLanguage()->getId();
    $configLanguages = $languageManager->getLanguages();
    $currentPath = \Drupal::service('path.current')->getPath();
    foreach ($configLanguages as $langcode => $language) {
      $meta = $langMeta[$langcode] ?? ['name' => $language->getName(), 'flag' => "\u{1F310}"];
      $entry = [
        'name' => $meta['name'],
        'code' => $langcode,
        'flag' => $meta['flag'],
        'active' => $langcode === $currentLang,
        'url' => '/' . $langcode . $currentPath,
      ];
      $languages[] = $entry;
      if ($entry['active']) {
        $variables['active_flag'] = $meta['flag'];
        $variables['active_name'] = $meta['name'];
      }
    }
  }
  $variables['languages'] = $languages;

  $route = \Drupal::routeMatch()->getRouteName();
  if ($route === 'user.login') {
    dx_portal_theme_preprocess_login_page($variables);
  }
}

/**
 * Login page: Topstar compact UI + dx_auth providers (incl. Google).
 */
function dx_portal_theme_preprocess_login_page(array &$variables): void {
  require_once __DIR__ . '/includes/login_i18n.php';
  $lang = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $login_i18n = dx_portal_theme_login_i18n_strings($lang);
  $variables['login_i18n'] = $login_i18n;
  $variables['login_layout'] = 'compact';
  $variables['#attached']['library'][] = 'dx_portal_theme/login';
  $variables['#attached']['drupalSettings']['dxLoginI18n'] = $login_i18n;
  $variables['#attached']['drupalSettings']['dxLoginLayout'] = 'compact';

  $auth = [
    'csrfToken' => \Drupal::csrfToken()->get(CsrfRequestHeaderAccessCheck::TOKEN_KEY),
    'lookupPath' => '/dx/auth/enterprise_lookup',
    'loginPath' => '/dx/auth/enterprise_login',
    'wechatQrPath' => '/dx/auth/wechat_qrcode',
    'wechatPollPath' => '/dx/auth/wechat_poll',
    'wechatMiddlePath' => '/dx/auth/wechat_middle',
    'wechatJumpPath' => '/dx/auth/wechat_jump',
    'smsSendPath' => '/dx/auth/sms_send',
    'smsLoginPath' => '/dx/auth/sms_login',
      'accountLoginPath' => '/dx/auth/account_login',
    'wechatEnabled' => FALSE,
    'websiteEnabled' => FALSE,
    'mpOauthEnabled' => FALSE,
    'app_type' => 'mp',
    'smsEnabled' => FALSE,
    'googleEnabled' => FALSE,
  ];

  $google_enabled = FALSE;
  $google_jump = '';
  $wechat_jump = '';
  $wechat_channel = '';
  if (\Drupal::moduleHandler()->moduleExists('dx_auth')) {
    if (\Drupal::hasService('page_cache_kill_switch')) {
      \Drupal::service('page_cache_kill_switch')->trigger();
    }
    $variables['#cache']['max-age'] = 0;
    $variables['#cache']['contexts'][] = 'ip';

    $request = \Drupal::request();
    if (\Drupal::hasService('dx_auth.wechat')) {
      $wechat = \Drupal::service('dx_auth.wechat');
      $auth['wechatEnabled'] = $wechat->isEnabled();
      // 前端仅接收应用类型和能力标记，不下发微信凭据。
      $auth['app_type'] = $wechat->appType();
      $auth['websiteEnabled'] = $wechat->channelEnabled('website');
      $auth['mpOauthEnabled'] = $wechat->mpOauthEnabled();
      $in_wechat = stripos((string) $request->headers->get('User-Agent', ''), 'MicroMessenger') !== FALSE;
      if ($in_wechat && $auth['mpOauthEnabled']) {
        $wechat_channel = 'mp';
      }
      elseif ($auth['websiteEnabled']) {
        $wechat_channel = 'website';
      }
      elseif ($auth['mpOauthEnabled']) {
        $wechat_channel = 'mp';
      }
      if ($wechat_channel !== '') {
        // Build language-neutral URL directly (Url::fromRoute adds /zh-hans/ prefix).
        $base = \Drupal::request()->getSchemeAndHttpHost();
        $wechat_jump = $base . '/dx/auth/wechat_jump?channel=' . $wechat_channel . '&return_to=' . urlencode((string) $request->query->get('destination', '/'));
      }
    }
    if (\Drupal::hasService('dx_auth.sms')) {
      $auth['smsEnabled'] = (bool) \Drupal::service('dx_auth.sms')->isEnabled();
    }
    if (\Drupal::hasService('dx_auth.google')) {
      $google_enabled = (bool) \Drupal::service('dx_auth.google')->isAvailable($request);
      $auth['googleEnabled'] = $google_enabled;
      if ($google_enabled) {
        $google_jump = Url::fromRoute('dx_auth.google_jump', [], [
          'query' => ['return_to' => '/'],
        ])->toString();
      }
    }
  }

  $variables['google_login_enabled'] = $google_enabled;
  $variables['google_jump_url'] = $google_jump;
  $variables['wechat_login_enabled'] = $auth['wechatEnabled'];
  $variables['wechat_app_type'] = $auth['app_type'];
  $variables['wechat_website_enabled'] = $auth['websiteEnabled'];
  $variables['wechat_mp_oauth_enabled'] = $auth['mpOauthEnabled'];
  $variables['wechat_oauth_channel'] = $wechat_channel;
  $variables['wechat_jump_url'] = $wechat_jump;
  $variables['#attached']['drupalSettings']['dxAuth'] = $auth;
}

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function dx_portal_theme_theme_suggestions_page_alter(array &$suggestions, array $variables): void {
  if (\Drupal::service('path.matcher')->isFrontPage()) {
    $suggestions[] = 'page__front';
  }

  $route = \Drupal::routeMatch()->getRouteName();
  if ($route === 'user.login') {
    $suggestions[] = 'page__user__login';
  }
  if ($route === 'user.pass' || $route === 'user.pass.reset') {
    $suggestions[] = 'page__user__pass';
  }
  if ($route === 'dx_ai_gateway.chat_page') {
    $suggestions[] = 'page__ai__chat';
  }
}
