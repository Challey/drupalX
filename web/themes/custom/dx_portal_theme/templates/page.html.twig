{#
/**
 * @file
 * Default page template for inner pages.
 */
#}
<div class="dx-shell">
  <header class="dx-top">
    <div class="dx-top__inner">
      <a class="dx-brand" href="{{ path('<front>') }}">Drupal<span>X</span><span class="dx-brand__tag">· {{ 'Boosting Yours'|t }}</span></a>
      <button type="button" class="dx-nav-toggle" aria-expanded="false" aria-controls="dx-primary-nav" data-dx-nav-toggle>
        <span class="visually-hidden">{{ 'Menu'|t }}</span>
        <span class="dx-nav-toggle__bars" aria-hidden="true"></span>
      </button>
      <nav id="dx-primary-nav" class="dx-nav" aria-label="{{ 'Primary'|t }}">
        <a href="{{ path('<front>') }}#about">{{ 'About'|t }}</a>
        <a href="/ai/chat">{{ 'AI Support'|t }}</a>
        <a href="/appstore">{{ 'App Store'|t }}</a>
        <a href="/edu">{{ 'Education'|t }}</a>
        {% if logged_in %}
          <a href="/user/logout">{{ 'Sign Out'|t }}</a>
        {% else %}
          <a href="/user/login">{{ 'Sign In'|t }}</a>
        {% endif %}
      </nav>
      {% if languages|length > 1 %}
        <div class="dx-lang-dropdown" data-dx-lang-dropdown>
          <button type="button" class="dx-lang-dropdown__toggle" aria-expanded="false" aria-haspopup="true">
            <span class="dx-lang-dropdown__flag">{{ active_flag }}</span>
            <span class="dx-lang-dropdown__name">{{ active_name }}</span>
            <svg class="dx-lang-dropdown__arrow" width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="dx-lang-dropdown__menu">
            {% for lang in languages %}
              <a href="{{ lang.url }}" class="dx-lang-dropdown__item{{ lang.active ? ' --active' : '' }}" lang="{{ lang.code }}">
                <span class="dx-lang-dropdown__flag">{{ lang.flag }}</span>
                <span>{{ lang.name }}</span>
              </a>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  </header>

  {% if page.highlighted %}
    <div class="region-highlighted">{{ page.highlighted }}</div>
  {% endif %}
  {% if page.help %}
    <div class="region-help">{{ page.help }}</div>
  {% endif %}

  <main class="dx-main" id="main-content" role="main">
    <div class="dx-content">
      {{ page.content }}
    </div>
  </main>

  <footer class="dx-foot">
    <div class="dx-foot__inner">
      <div><strong>DrupalX · {{ 'Boosting Yours'|t }}</strong></div>
      <div class="dx-foot__powered">Powered by <a href="https://www.drupal.org" target="_blank" rel="noopener noreferrer">Drupal®</a></div>
      <div>{{ page.footer }}</div>
    </div>
    {% include '@dx_portal_theme/includes/dx-legal-footer.html.twig' %}
  </footer>
</div>
