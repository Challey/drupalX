{#
/**
 * @file
 * Front page — one brand-led composition.
 */
#}
<div class="dx-shell path-frontpage">
  <header class="dx-top">
    <div class="dx-top__inner">
      <a class="dx-brand" href="{{ path('<front>') }}">Drupal<span>X</span></a>
      <button type="button" class="dx-nav-toggle" aria-expanded="false" aria-controls="dx-primary-nav" data-dx-nav-toggle>
        <span class="visually-hidden">{{ '菜单'|t }}</span>
        <span class="dx-nav-toggle__bars" aria-hidden="true"></span>
      </button>
      <nav id="dx-primary-nav" class="dx-nav" aria-label="{{ 'Primary'|t }}">
        <a href="#capabilities">{{ '能力'|t }}</a>
        <a href="/products">{{ '产品与服务'|t }}</a>
        <a href="/media-center">{{ '媒体中心'|t }}</a>
        <a href="/ai/chat">{{ 'AI 客服'|t }}</a>
        <a href="/appstore">{{ '应用商店'|t }}</a>
        <a href="/user/login">{{ '统一登录'|t }}</a>
        <a class="dx-btn dx-btn--primary" href="/user/register">{{ '开通门户'|t }}</a>
      </nav>
    </div>
  </header>

  <main class="dx-main" id="main-content" role="main">
    <section class="dx-hero" aria-label="{{ 'Hero'|t }}">
      <div class="dx-hero__media" aria-hidden="true"></div>
      <div class="dx-hero__inner">
        <p class="dx-hero__brand">Drupal<span>X</span></p>
        <h1 class="dx-hero__headline">{{ '中小企业自己的 AI 数字门户'|t }}</h1>
        <p class="dx-hero__lead">{{ '一站式接入国内外大模型，发布权威产品与媒体窗口，按需启用可信 Drupal 应用。'|t }}</p>
        <div class="dx-hero__cta">
          <a class="dx-btn dx-btn--light" href="/ai/chat">{{ '试用 AI 客服'|t }}</a>
          <a class="dx-btn dx-btn--ghost" href="/user/login" style="color:#fff;border-color:rgba(255,255,255,.45)">{{ '进入控制台'|t }}</a>
        </div>
      </div>
    </section>

    <section class="dx-section" id="capabilities">
      <h2 class="dx-section__title">{{ '三件事，一次配齐'|t }}</h2>
      <p class="dx-section__lead">{{ '面向中小微企业的混合 SaaS 底座：独立门户、统一 AI、可插拔模块商店。'|t }}</p>
      <div class="dx-rail">
        <article class="dx-feature">
          <h3>{{ 'AI 一站式接入'|t }}</h3>
          <p>{{ 'OpenAI、DeepSeek、通义、智谱等模型统一网关，配额与客服入口开箱即用。'|t }}</p>
          <p><a href="/ai/chat">{{ '打开 AI 客服 →'|t }}</a></p>
        </article>
        <article class="dx-feature">
          <h3>{{ '权威产品与媒体窗'|t }}</h3>
          <p>{{ '公司主页、产品发布、媒体中心，形成对外正式数字形象。'|t }}</p>
        </article>
        <article class="dx-feature">
          <h3>{{ 'Drupal App Store'|t }}</h3>
          <p>{{ '策展可信模块池：社交、OSS、电商、营销，快速申请安装与分成。'|t }}</p>
        </article>
      </div>
    </section>

    <section class="dx-band">
      <div class="dx-section dx-band__row">
        <div>
          <h2 class="dx-section__title">{{ '为租户一键开通独立站点'|t }}</h2>
          <p class="dx-section__lead" style="margin-bottom:0">{{ '共享代码库，独立数据库与子域门户 — 正式、隔离、可运维。'|t }}</p>
        </div>
        <a class="dx-btn dx-btn--primary" href="/admin/dx/platform">{{ '平台控制台'|t }}</a>
      </div>
    </section>
  </main>

  <footer class="dx-foot">
    <div class="dx-foot__inner">
      <div><strong>DrupalX</strong> · {{ '中小企业 AI 数字门户平台'|t }}</div>
      <div>{{ 'Powered by Drupal'|t }} <sup>®</sup></div>
    </div>
    {% include '@dx_portal_theme/includes/dx-legal-footer.html.twig' %}
  </footer>
</div>
