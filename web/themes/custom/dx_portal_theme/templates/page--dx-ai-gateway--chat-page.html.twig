{#
/**
 * @file
 * AI chat page — no nested content card; widget owns its chrome.
 */
#}
<div class="dx-shell path-ai-chat-page">
  <header class="dx-top">
    <div class="dx-top__inner">
      <a class="dx-brand" href="{{ path('<front>') }}">Drupal<span>X</span><span class="dx-brand__zh">助跑</span></a>
      <button type="button" class="dx-nav-toggle" aria-expanded="false" aria-controls="dx-primary-nav" aria-label="{{ '菜单'|t }}">
        <span class="dx-nav-toggle__bars" aria-hidden="true"></span>
      </button>
      <nav id="dx-primary-nav" class="dx-nav" aria-label="{{ 'Primary'|t }}">
        <a href="{{ path('<front>') }}#capabilities">{{ '能力'|t }}</a>
        <a href="/products">{{ '产品与服务'|t }}</a>
        <a href="/media-center">{{ '媒体中心'|t }}</a>
        <a href="/ai/chat">{{ 'AI 客服'|t }}</a>
        <a href="/appstore">{{ '应用商店'|t }}</a>
        {% if logged_in %}
          <a href="/user">{{ '账户'|t }}</a>
          <a href="/user/logout">{{ '退出'|t }}</a>
        {% else %}
          <a href="/user/login">{{ '登录'|t }}</a>
          <a class="dx-btn dx-btn--primary" href="/user/login">{{ '进入控制台'|t }}</a>
        {% endif %}
      </nav>
    </div>
  </header>

  <main class="dx-main dx-main--chat" id="main-content" role="main">
    {{ page.content }}
  </main>

  <footer class="dx-foot">
    <div class="dx-foot__inner">
      <div><strong>DrupalX 助跑</strong></div>
      <div>{{ page.footer }}</div>
    </div>
    {% include '@dx_portal_theme/includes/dx-legal-footer.html.twig' %}
  </footer>
</div>
