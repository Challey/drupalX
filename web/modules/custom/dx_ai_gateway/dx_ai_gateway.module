<?php

/**
 * @file
 * Primary module hooks for DrupalX AI Gateway.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function dx_ai_gateway_help($route_name, RouteMatchInterface $route_match): string {
  switch ($route_name) {
    case 'help.page.dx_ai_gateway':
      return '<p>' . t('Provides a multi-provider AI gateway with failover and customer service chat.') . '</p>';

    default:
      return '';
  }
}

/**
 * Implements hook_theme().
 */
function dx_ai_gateway_theme(array $existing, $type, $theme, $path): array {
  return [
    'dx_ai_chat' => [
      'variables' => [
        'messages' => [],
        'endpoint' => '',
        'stream_endpoint' => '',
      ],
      'template' => 'dx-ai-chat',
    ],
    'dx_ai_chat_page' => [
      'variables' => [
        'chat' => [],
        'usage' => [],
      ],
      'template' => 'dx-ai-chat-page',
    ],
  ];
}

/**
 * Implements hook_page_attachments_alter().
 *
 * Keep /ai/chat free of third-party builder/slider CSS that pollutes forms.
 */
function dx_ai_gateway_page_attachments_alter(array &$attachments): void {
  $route = \Drupal::routeMatch()->getRouteName();
  if ($route !== 'dx_ai_gateway.chat_page') {
    return;
  }
  if (empty($attachments['#attached']['library']) || !is_array($attachments['#attached']['library'])) {
    return;
  }
  $attachments['#attached']['library'] = array_values(array_filter(
    $attachments['#attached']['library'],
    static function ($library): bool {
      if (!is_string($library)) {
        return TRUE;
      }
      return !preg_match('/^(gavias_|gva_|gaviasthemer)/', $library);
    }
  ));
}
