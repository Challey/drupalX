<?php

/**
 * @file
 * Primary module hooks for DrupalX AI Gateway.
 */

use Drupal\Core\Access\CsrfRequestHeaderAccessCheck;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Url;

/**
 * Implements hook_help().
 */
function dx_ai_gateway_help($route_name, RouteMatchInterface $route_match): string {
  switch ($route_name) {
    case 'help.page.dx_ai_gateway':
      return '<p>' . t('Provides a multi-provider AI gateway with failover and customer service chat.') . '</p>';

    default:
      return '';
  }
}

/**
 * Implements hook_theme().
 */
function dx_ai_gateway_theme(array $existing, $type, $theme, $path): array {
  return [
    'dx_ai_chat' => [
      'variables' => [
        'messages' => [],
        'endpoint' => '',
        'stream_endpoint' => '',
        'csrf_token' => '',
        'csrf_url' => '',
      ],
      'template' => 'dx-ai-chat',
    ],
    'dx_ai_chat_page' => [
      'variables' => [
        'chat' => [],
        'usage' => [],
      ],
      'template' => 'dx-ai-chat-page',
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for dx_ai_chat.
 */
function dx_ai_gateway_preprocess_dx_ai_chat(array &$variables): void {
  if ($variables['endpoint'] === '') {
    $variables['endpoint'] = Url::fromRoute('dx_ai_gateway.chat')->toString();
  }
  if ($variables['stream_endpoint'] === '') {
    $variables['stream_endpoint'] = Url::fromRoute('dx_ai_gateway.chat_stream')->toString();
  }
  $variables['csrf_token'] = \Drupal::csrfToken()->get(CsrfRequestHeaderAccessCheck::TOKEN_KEY);
  $variables['csrf_url'] = Url::fromRoute('system.csrftoken')->toString();
}

/**
 * Returns shared attachments for the AI chat widget.
 */
function dx_ai_gateway_chat_attachments(): array {
  return [
    'library' => ['dx_ai_gateway/chat'],
    'drupalSettings' => [
      'dxAiChat' => [
        'csrfToken' => \Drupal::csrfToken()->get(CsrfRequestHeaderAccessCheck::TOKEN_KEY),
        'csrfUrl' => Url::fromRoute('system.csrftoken')->toString(),
      ],
    ],
  ];
}
