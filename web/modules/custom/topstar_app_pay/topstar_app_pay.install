<?php

/**
 * @file
 * Schema for App WeChat pay intents.
 */

declare(strict_types=1);

/**
 * Implements hook_schema().
 */
function topstar_app_pay_schema(): array {
  $schema['topstar_app_pay_intent'] = [
    'description' => 'WeChat H5/JSAPI/Native pay intents for App and H5 clients.',
    'fields' => [
      'intent_id' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'description' => 'Public intent id.',
      ],
      'out_trade_no' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
      ],
      'uid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'product' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'membership',
      ],
      'plan' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => '',
      ],
      'amount_fen' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'channel' => [
        'type' => 'varchar',
        'length' => 16,
        'not null' => TRUE,
        'default' => 'h5',
      ],
      'status' => [
        'type' => 'varchar',
        'length' => 16,
        'not null' => TRUE,
        'default' => 'pending',
      ],
      'transaction_id' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
      ],
      'payload' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
      ],
      'created' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'changed' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['intent_id'],
    'unique keys' => [
      'out_trade_no' => ['out_trade_no'],
    ],
    'indexes' => [
      'status' => ['status'],
      'uid_product' => ['uid', 'product'],
    ],
  ];
  return $schema;
}
