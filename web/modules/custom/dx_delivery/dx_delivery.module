<?php

/**
 * @file
 * DrupalX Delivery module.
 */

declare(strict_types=1);

/**
 * Implements hook_theme().
 */
function dx_delivery_theme($existing, $type, $theme, $path): array {
  return [
    'dx_delivery_desk' => [
      'variables' => [
        'title' => NULL,
        'intro' => NULL,
        'wizard_url' => NULL,
        'chat_url' => NULL,
        'recent' => [],
        'health_ok' => TRUE,
        'health_msg' => '',
      ],
      'template' => 'dx-delivery-desk',
    ],
    'dx_delivery_blueprint' => [
      'variables' => [
        'blueprint' => NULL,
        'site_type' => '',
        'summary_rows' => [],
        'payload_json' => '',
        'acceptance_json' => '',
        'acceptance_steps' => [],
        'acceptance_passed' => FALSE,
        'portal_url' => '',
        'acceptance_download_url' => '',
        'ops_links' => [],
        'handoff_todos' => [],
        'confirm_url' => NULL,
        'log' => '',
      ],
      'template' => 'dx-delivery-blueprint',
    ],
    'dx_delivery_status_tabs' => [
      'variables' => [
        'tabs' => [],
        'label' => NULL,
      ],
      'template' => 'dx-delivery-status-tabs',
    ],
    'dx_delivery_todo_board' => [
      'variables' => [
        'title' => NULL,
        'intro' => NULL,
        'notice' => '',
        'filter' => 'open',
        'tabs' => [],
        'blueprint_tabs' => [],
        'blueprint_filter' => 0,
        'clear_url' => '',
        'rows' => [],
        'stats' => [],
        'empty_text' => '',
        'empty_hint' => '',
        'can_complete' => FALSE,
        'drush_hint' => '',
      ],
      'template' => 'dx-delivery-todos',
    ],
  ];
}
