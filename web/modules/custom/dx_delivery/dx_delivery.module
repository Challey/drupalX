<?php

/**
 * @file
 * DrupalX Delivery module.
 */

declare(strict_types=1);

/**
 * Implements hook_theme().
 */
function dx_delivery_theme($existing, $type, $theme, $path): array {
  return [
    'dx_delivery_desk' => [
      'variables' => [
        'title' => NULL,
        'intro' => NULL,
        'wizard_url' => NULL,
        'chat_url' => NULL,
        'recent' => [],
        'health_ok' => TRUE,
        'health_msg' => '',
      ],
      'template' => 'dx-delivery-desk',
    ],
    'dx_delivery_blueprint' => [
      'variables' => [
        'blueprint' => NULL,
        'site_type' => '',
        'summary_rows' => [],
        'payload_json' => '',
        'acceptance_json' => '',
        'acceptance_steps' => [],
        'acceptance_passed' => FALSE,
        'portal_url' => '',
        'acceptance_download_url' => '',
        'ops_links' => [],
        'confirm_url' => NULL,
        'log' => '',
        'todos' => [],
        'todo_open' => 0,
        'todo_total' => 0,
        'checklist' => [],
      ],
      'template' => 'dx-delivery-blueprint',
    ],
  ];
}
