<?php

/**
 * @file
 * Install hooks for dx_delivery.
 */

declare(strict_types=1);

/**
 * Implements hook_install().
 */
function dx_delivery_install(): void {
  // Ensure content entity schema exists even if prior install was interrupted.
  $definition = \Drupal::entityTypeManager()->getDefinition('dx_blueprint', FALSE);
  if ($definition && !\Drupal::database()->schema()->tableExists('dx_blueprint')) {
    \Drupal::entityDefinitionUpdateManager()->installEntityType($definition);
  }

  user_role_grant_permissions('anonymous', ['access dx delivery desk']);
  user_role_grant_permissions('authenticated', ['access dx delivery desk']);
  if (\Drupal::entityTypeManager()->getStorage('user_role')->load('administrator')) {
    user_role_grant_permissions('administrator', [
      'access dx delivery desk',
      'access dx delivery todos',
      'administer dx delivery',
    ]);
  }
}

/**
 * Grant the L3 handoff todo board permission to the administrator role.
 *
 * The desk permission is deliberately untouched: /deliver and /order keep the
 * audience they have on the live site.
 */
function dx_delivery_update_11001(): void {
  if (\Drupal::entityTypeManager()->getStorage('user_role')->load('administrator')) {
    user_role_grant_permissions('administrator', ['access dx delivery todos']);
  }
}
