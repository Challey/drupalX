        'label' => [
          'type' => 'varchar',
          'length' => 128,
          'not null' => TRUE,
          'default' => '',
        ],
        'active' => [
          'type' => 'int',
          'not null' => TRUE,
          'default' => 1,
        ],
        'max_uses' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
          'default' => 0,
        ],
        'uses' => [
          'type' => 'int',
          'unsigned' => TRUE,
          'not null' => TRUE,
