<?php

/**
 * @file
 * Primary module hooks for DrupalX Platform.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function dx_platform_help($route_name, RouteMatchInterface $route_match): string {
  switch ($route_name) {
    case 'help.page.dx_platform':
      $output = '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('DrupalX Platform manages hybrid SaaS tenant provisioning, database creation, and multi-site configuration.') . '</p>';
      return $output;

    case 'dx_platform.dashboard':
      return '<p>' . t('Overview of all registered tenants and their provisioning status.') . '</p>';

    default:
      return '';
  }
}
