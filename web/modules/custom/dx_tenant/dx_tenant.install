<?php

/**
 * @file
 * Install and update hooks for dx_tenant.
 */

declare(strict_types=1);

/**
 * Ensure AI-related tenant settings keys exist for older sites.
 */
function dx_tenant_update_10001(): void {
  $config = \Drupal::configFactory()->getEditable('dx_tenant.settings');
  $defaults = [
    'ai_quota_monthly' => 100000,
    'ai_default_provider' => '',
    'ai_system_prompt' => '',
    'ai_knowledge_intro' => '',
  ];
  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
    }
  }
  $config->save();
}

/**
 * Migrates the legacy quota convention to an explicit override flag.
 */
function dx_tenant_update_10002(): void {
  $config = \Drupal::configFactory()->getEditable('dx_tenant.settings');
  if ($config->get('ai_quota_override') === NULL) {
    // Legacy positive values were tenant quotas; zero inherited the platform.
    $config->set(
      'ai_quota_override',
      (int) $config->get('ai_quota_monthly') > 0,
    );
    $config->save();
  }
}


/**
 * Adds enterprise credit ID to tenant settings.
 */
function dx_tenant_update_10003(): void {
  $config = \Drupal::configFactory()->getEditable('dx_tenant.settings');
  if ($config->get('credit_code') === NULL) {
    $config->set('credit_code', '')->save();
  }
}
