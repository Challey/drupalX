<?php

/**
 * @file
 * Hooks for DrupalX OSS pack.
 */

declare(strict_types=1);

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function dx_oss_help($route_name, RouteMatchInterface $route_match): string {
  if ($route_name === 'help.page.dx_oss') {
    return '<p>' . t('Guides enabling Aliyun OSS or Tencent COS for public/private files. Stores credentials in State and validates connectivity.') . '</p>';
  }
  return '';
}
