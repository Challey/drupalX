<?php

/**
 * @file
 * Primary module hooks for DrupalX Tenant.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function dcn_tenant_help($route_name, RouteMatchInterface $route_match): string {
  switch ($route_name) {
    case 'help.page.dcn_tenant':
      return '<p>' . t('Configure company profile and tenant-level settings for this DrupalX site.') . '</p>';

    case 'dcn_tenant.settings':
      return '<p>' . t('Set company name, industry, logo, and AI usage quota for this tenant.') . '</p>';

    default:
      return '';
  }
}
