<div class="dx-product-list">
  <header class="dx-portal-section__head">
    <h1>{{ 'Products'|t }}</h1>
    <p>{{ 'Browse published products from this DrupalX portal.'|t }}</p>
  </header>
  {% if products %}
    <ul class="dx-product-list__grid">
      {% for product in products %}
        <li class="dx-product-list__item">
          <h2><a href="{{ product.url }}">{{ product.title }}</a></h2>
          <p class="dx-product-list__meta">
            {% if product.sku %}<span>{{ 'SKU'|t }}: {{ product.sku }}</span>{% endif %}
            {% if product.price %}<span class="dx-product-list__price">{{ product.price }}</span>{% endif %}
          </p>
          {% if product.summary %}<p class="dx-product-list__summary">{{ product.summary }}</p>{% endif %}
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="dx-portal-empty">{{ 'No products published yet. Create Product content (dx_product) to populate this page.'|t }}</p>
  {% endif %}
</div>
