<div class="dx-media-list">
  <div class="dx-page-header">
    <h2 class="dx-section__title">{{ 'Media & News Center'|t }}</h2>
    <p class="dx-section__lead">{{ 'Official press releases, announcements, and articles.'|t }}</p>
  </div>
  {% if items %}
    <div class="dx-media-grid">
      {% for item in items %}
        <article class="dx-media-card">
          <h3 class="dx-media-card__title">
            <a href="{{ item.url }}">{{ item.title }}</a>
          </h3>
          {% if item.summary %}
            <p class="dx-media-card__summary">{{ item.summary }}</p>
          {% endif %}
          <a href="{{ item.url }}" class="dx-media-card__link">{{ 'Read full article →'|t }}</a>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <div class="dx-empty-state">
      <p>{{ 'No media items published yet.'|t }}</p>
    </div>
  {% endif %}
</div>

