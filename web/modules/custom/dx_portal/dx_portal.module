<?php

/**
 * @file
 * Primary module hooks for DrupalX Portal.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function dx_portal_help($route_name, RouteMatchInterface $route_match): string {
  switch ($route_name) {
    case 'help.page.dx_portal':
      return '<p>' . t('Provides portal front pages for products and media center content. Seed demos with <code>drush dx:portal-seed</code>.') . '</p>';

    default:
      return '';
  }
}

/**
 * Implements hook_theme().
 */
function dx_portal_theme(array $existing, $type, $theme, $path): array {
  return [
    'dx_portal_product_list' => [
      'variables' => ['products' => []],
    ],
    'dx_portal_media_list' => [
      'variables' => ['items' => []],
    ],
  ];
}

/**
 * Implements hook_page_attachments().
 * Injects OpenGraph & WeChat metadata tags into portal pages.
 */
function dx_portal_page_attachments(array &$page): void {
  $tenantConfig = \Drupal::config('dx_tenant.settings');
  $companyName = $tenantConfig->get('company_name') ?: 'DrupalX SME AI Portal';

  // OpenGraph site name.
  $ogSiteName = [
    '#tag' => 'meta',
    '#attributes' => [
      'property' => 'og:site_name',
      'content' => $companyName,
    ],
  ];
  $page['#attached']['html_head'][] = [$ogSiteName, 'og_site_name'];

  // WeChat share description hint.
  $wechatDesc = [
    '#tag' => 'meta',
    '#attributes' => [
      'name' => 'description',
      'content' => $companyName . ' — 专业数字化展示与智能客户服务门户',
    ],
  ];
  $page['#attached']['html_head'][] = [$wechatDesc, 'meta_description'];
}

