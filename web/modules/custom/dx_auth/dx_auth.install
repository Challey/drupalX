<?php

/**
 * @file
 * Install hooks for dx_auth.
 */

declare(strict_types=1);

/**
 * Implements hook_install().
 */
function dx_auth_install(): void {
  // Grant admin permission so /admin/dx/auth/providers is reachable.
  user_role_grant_permissions('administrator', ['administer dx auth']);
}


/**
 * Implements hook_schema().
 */
function dx_auth_schema(): array {
  $schema['dx_auth_enterprise'] = [
    'description' => 'Maps market-supervision enterprise credit IDs to Drupal users.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'credit_code' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
      ],
      'uid' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'company_name' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
      'changed' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'credit_code' => ['credit_code'],
    ],
    'indexes' => [
      'uid' => ['uid'],
    ],
  ];

  $schema['dx_auth_wechat'] = [
    'description' => 'WeChat openid → Drupal uid (Topstar wechatquery_wechat_user port).',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'openid' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'created' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'unique keys' => ['openid' => ['openid']],
    'indexes' => ['uid' => ['uid']],
  ];

  $schema['dx_auth_google'] = [
    'description' => 'Google subject → Drupal uid (Topstar wechatquery_google_user port).',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'google_sub' => ['type' => 'varchar', 'length' => 64, 'not null' => TRUE],
      'email' => ['type' => 'varchar', 'length' => 254, 'not null' => TRUE, 'default' => ''],
      'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'created' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'unique keys' => ['google_sub' => ['google_sub']],
    'indexes' => ['uid' => ['uid'], 'email' => ['email']],
  ];

  $schema['dx_auth_mobile'] = [
    'description' => 'Verified mobile → Drupal uid.',
    'fields' => [
      'id' => ['type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE],
      'mobile' => ['type' => 'varchar', 'length' => 32, 'not null' => TRUE],
      'uid' => ['type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0],
      'created' => ['type' => 'int', 'not null' => TRUE, 'default' => 0],
    ],
    'primary key' => ['id'],
    'unique keys' => ['mobile' => ['mobile']],
    'indexes' => ['uid' => ['uid']],
  ];

  return $schema;
}

/**
 * Add WeChat / Google / mobile binding tables.
 */
function dx_auth_update_10001(): void {
  $schema = dx_auth_schema();
  $db = \Drupal::database();
  foreach (['dx_auth_wechat', 'dx_auth_google', 'dx_auth_mobile'] as $table) {
    if (!$db->schema()->tableExists($table)) {
      $db->schema()->createTable($table, $schema[$table]);
    }
  }
}


/**
 * Grant administer dx auth and ensure provider settings config exists.
 */
function dx_auth_update_10002(): void {
  user_role_grant_permissions('administrator', ['administer dx auth']);
  $config = \Drupal::configFactory()->getEditable('dx_auth.settings');
  if ($config->isNew() || $config->get('sms_sign_name') === NULL) {
    $defaults = [
      'wechat_enabled' => FALSE,
      'wechat_app_id' => '',
      'wechat_secret' => '',
      'wechat_token' => '',
      'wechat_switch' => FALSE,
      'sms_enabled' => FALSE,
      'sms_access_key' => '',
      'sms_access_secret' => '',
      'sms_sign_name' => 'DrupalX',
      'sms_template_code' => '',
      'google_enabled' => FALSE,
      'google_client_id' => '',
      'google_client_secret' => '',
      'google_redirect_uri' => '',
      'google_ignore_geo' => FALSE,
    ];
    foreach ($defaults as $key => $value) {
      if ($config->get($key) === NULL) {
        $config->set($key, $value);
      }
    }
    $config->save();
  }
}
