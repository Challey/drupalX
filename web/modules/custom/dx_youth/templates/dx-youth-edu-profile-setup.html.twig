{#
/**
 * @file
 * Education profile setup page for unified login users.
 * Clean layout matching original design: tier buttons + simple inputs.
 * School field supports filtering by district & level, plus manual input.
 * Class field is text-only input.
 */
#}
<div class="edu-profile-setup">
  <div class="edu-profile-header">
    <h1>🎓 完善教育档案</h1>
    <p>请填写您的教育信息，以便获得个性化的学习体验。</p>
  </div>

  <form id="edu-profile-form" class="edu-profile-form">
    {# Tier Selection #}
    <div class="form-group">
      <label>我是 <span class="required">*</span></label>
      <div class="tier-options">
        <label class="tier-option">
          <input type="radio" name="tier" value="k12" checked>
          <span class="tier-label">🎒 中小学生</span>
        </label>
        <label class="tier-option">
          <input type="radio" name="tier" value="highschool">
          <span class="tier-label">🔬 高中生</span>
        </label>
        <label class="tier-option">
          <input type="radio" name="tier" value="college">
          <span class="tier-label">🚀 大学生</span>
        </label>
      </div>
    </div>

    {# K12 Fields #}
    <div id="k12-fields" class="tier-fields">
      <div class="form-group">
        <label for="real_name">姓名 <span class="required">*</span></label>
        <input type="text" id="real_name" name="real_name" maxlength="64" required>
      </div>

      <div class="form-group">
        <label for="school">学校 <span class="required">*</span></label>
        <div class="school-filter-row">
          <select id="school-district" class="school-filter-select">
            <option value="">全部区域</option>
          </select>
          <select id="school-level" class="school-filter-select">
            <option value="">全部学段</option>
            <option value="primary">小学</option>
            <option value="middle">初中</option>
            <option value="high">高中</option>
            <option value="university">大学</option>
          </select>
        </div>
        <input type="text" id="school" name="school" maxlength="128" required list="school-list" placeholder="输入或选择学校" style="margin-top:0.5rem;">
        <datalist id="school-list"></datalist>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="grade_year">年级</label>
          <select id="grade_year" name="grade_year">
            <option value="0">请选择</option>
            <option value="1">一年级</option>
            <option value="2">二年级</option>
            <option value="3">三年级</option>
            <option value="4">四年级</option>
            <option value="5">五年级</option>
            <option value="6">六年级</option>
            <option value="7">初一</option>
            <option value="8">初二</option>
            <option value="9">初三</option>
          </select>
        </div>
        <div class="form-group">
          <label for="class_name">班级</label>
          <input type="text" id="class_name" name="class_name" maxlength="64" placeholder="如：4 或 四（1）班">
        </div>
      </div>

      <div class="form-group">
        <label for="interests_text">兴趣爱好</label>
        <textarea id="interests_text" name="interests" rows="3" placeholder="如：阅读（哈利波特），AI/SI，长跑，越野跑，主持"></textarea>
      </div>
    </div>

    {# High School Fields #}
    <div id="highschool-fields" class="tier-fields" style="display:none;">
      <div class="form-group">
        <label for="hs_real_name">姓名 <span class="required">*</span></label>
        <input type="text" id="hs_real_name" name="real_name" maxlength="64" required>
      </div>
      <div class="form-group">
        <label for="hs_school">学校 <span class="required">*</span></label>
        <div class="school-filter-row">
          <select id="hs-school-district" class="school-filter-select">
            <option value="">全部区域</option>
          </select>
          <select id="hs-school-level" class="school-filter-select">
            <option value="">全部学段</option>
            <option value="high">高中</option>
            <option value="vocational">职高/中专</option>
          </select>
        </div>
        <input type="text" id="hs_school" name="school" maxlength="128" required list="hs-school-list" placeholder="输入或选择学校" style="margin-top:0.5rem;">
        <datalist id="hs-school-list"></datalist>
      </div>
      <div class="form-group">
        <label for="hs_specialty">专业方向</label>
        <input type="text" id="hs_specialty" name="specialty" maxlength="64">
      </div>
      <div class="form-group">
        <label for="hs_career">职业规划</label>
        <input type="text" id="hs_career" name="career_interest" maxlength="128">
      </div>
      <div class="form-group">
        <label for="hs_interests">兴趣爱好</label>
        <textarea id="hs_interests" name="interests" rows="3" placeholder="如：物理竞赛，编程，天文"></textarea>
      </div>
    </div>

    {# College Fields #}
    <div id="college-fields" class="tier-fields" style="display:none;">
      <div class="form-group">
        <label for="col_real_name">姓名 <span class="required">*</span></label>
        <input type="text" id="col_real_name" name="real_name" maxlength="64" required>
      </div>
      <div class="form-group">
        <label for="col_university">大学 <span class="required">*</span></label>
        <div class="school-filter-row">
          <select id="col-school-district" class="school-filter-select">
            <option value="">全部区域</option>
          </select>
          <select id="col-school-level" class="school-filter-select" style="display:none;">
            <option value="university" selected>大学</option>
          </select>
        </div>
        <input type="text" id="col_university" name="university" maxlength="128" required list="col-school-list" placeholder="输入或选择大学" style="margin-top:0.5rem;">
        <datalist id="col-school-list"></datalist>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="major">专业</label>
          <input type="text" id="major" name="major" maxlength="64">
        </div>
        <div class="form-group">
          <label for="enrollment_year">入学年份</label>
          <input type="number" id="enrollment_year" name="enrollment_year" min="2000" max="2030">
        </div>
      </div>
      <div class="form-group">
        <label for="col_career">职业规划</label>
        <input type="text" id="col_career" name="career_interest" maxlength="128">
      </div>
      <div class="form-group">
        <label for="col_bio">个人简介</label>
        <textarea id="col_bio" name="bio" rows="4"></textarea>
      </div>
    </div>

    <div id="profile-message" class="profile-message"></div>

    <button type="submit">保存并继续</button>
  </form>
</div>

<script>
(function() {
  const settings = drupalSettings.dxYouth || {};
  const existing = settings.existingProfile;
  const endpoint = settings.eduProfileEndpoint;
  const schoolsEndpoint = settings.schoolsEndpoint || (endpoint || '').replace('edu-profile-save', 'schools');
  let allSchools = [];
  let allDistricts = [];

  // Load schools data
  async function loadSchools() {
    try {
      const resp = await fetch(schoolsEndpoint);
      const result = await resp.json();
      if (result.ok) {
        allSchools = result.schools || [];
        allDistricts = result.districts || [];
        populateDistrictFilters();
        updateSchoolList('school-district', 'school-level', 'school-list');
        updateSchoolList('hs-school-district', 'hs-school-level', 'hs-school-list');
        updateSchoolList('col-school-district', 'col-school-level', 'col-school-list');
      }
    } catch (err) {
      console.error('Failed to load schools:', err);
    }
  }

  function populateDistrictFilters() {
    const selects = ['school-district', 'hs-school-district', 'col-school-district'];
    selects.forEach(id => {
      const select = document.getElementById(id);
      if (!select) return;
      allDistricts.forEach(d => {
        const opt = document.createElement('option');
        opt.value = d.id;
        opt.textContent = d.name;
        select.appendChild(opt);
      });
    });
  }

  function updateSchoolList(districtId, levelId, datalistId) {
    const district = document.getElementById(districtId)?.value || '';
    const level = document.getElementById(levelId)?.value || '';
    const datalist = document.getElementById(datalistId);
    if (!datalist) return;
    datalist.innerHTML = '';
    let filtered = allSchools;
    if (district) filtered = filtered.filter(s => s.district === district);
    if (level) filtered = filtered.filter(s => s.level === level);
    filtered.forEach(s => {
      const opt = document.createElement('option');
      opt.value = s.name;
      datalist.appendChild(opt);
    });
  }

  // Restore existing data
  if (existing) {
    const tier = existing.tier || 'k12';
    document.querySelector('input[name="tier"][value="' + tier + '"]').checked = true;
    switchTierFields(tier);

    if (tier === 'k12') {
      document.getElementById('real_name').value = existing.real_name || '';
      document.getElementById('school').value = existing.school || '';
      document.getElementById('grade_year').value = existing.grade_year || 0;
      document.getElementById('class_name').value = existing.class_name || '';
    }
    if (existing.interests) {
      document.getElementById('interests_text').value = existing.interests;
    }
    if (existing.school_level) document.getElementById('school_level')?.value = existing.school_level;
    if (existing.specialty) document.getElementById('hs_specialty').value = existing.specialty;
    if (existing.career_interest) {
      document.getElementById('hs_career').value = existing.career_interest;
      document.getElementById('col_career').value = existing.career_interest;
    }
    if (existing.university) document.getElementById('col_university').value = existing.university;
    if (existing.major) document.getElementById('major').value = existing.major;
    if (existing.enrollment_year) document.getElementById('enrollment_year').value = existing.enrollment_year;
    if (existing.bio) document.getElementById('col_bio').value = existing.bio;
  }

  // Tier switching
  document.querySelectorAll('input[name="tier"]').forEach(radio => {
    radio.addEventListener('change', function() {
      switchTierFields(this.value);
    });
  });

  function switchTierFields(tier) {
    document.getElementById('k12-fields').style.display = tier === 'k12' ? '' : 'none';
    document.getElementById('highschool-fields').style.display = tier === 'highschool' ? '' : 'none';
    document.getElementById('college-fields').style.display = tier === 'college' ? '' : 'none';
  }

  // Filter change handlers for K12
  document.getElementById('school-district')?.addEventListener('change', function() {
    updateSchoolList('school-district', 'school-level', 'school-list');
  });
  document.getElementById('school-level')?.addEventListener('change', function() {
    updateSchoolList('school-district', 'school-level', 'school-list');
  });

  // Filter change handlers for High School
  document.getElementById('hs-school-district')?.addEventListener('change', function() {
    updateSchoolList('hs-school-district', 'hs-school-level', 'hs-school-list');
  });
  document.getElementById('hs-school-level')?.addEventListener('change', function() {
    updateSchoolList('hs-school-district', 'hs-school-level', 'hs-school-list');
  });

  // Filter change handlers for College
  document.getElementById('col-school-district')?.addEventListener('change', function() {
    updateSchoolList('col-school-district', 'col-school-level', 'col-school-list');
  });

  // Initialize
  loadSchools();

  // Form submission
  document.getElementById('edu-profile-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    const msgEl = document.getElementById('profile-message');
    const btn = this.querySelector('button[type="submit"]');
    btn.disabled = true;
    msgEl.textContent = '正在保存...';
    msgEl.className = 'profile-message';

    const tier = document.querySelector('input[name="tier"]:checked').value;
    const data = { tier };

    if (tier === 'k12') {
      data.real_name = document.getElementById('real_name').value;
      data.school = document.getElementById('school').value;
      data.grade_year = parseInt(document.getElementById('grade_year').value) || 0;
      data.class_name = document.getElementById('class_name').value;
      data.interests = document.getElementById('interests_text').value;
    } else if (tier === 'highschool') {
      data.real_name = document.getElementById('hs_real_name').value;
      data.school = document.getElementById('hs_school').value;
      data.specialty = document.getElementById('hs_specialty').value;
      data.career_interest = document.getElementById('hs_career').value;
      data.interests = document.getElementById('hs_interests').value;
    } else {
      data.real_name = document.getElementById('col_real_name').value;
      data.university = document.getElementById('col_university').value;
      data.major = document.getElementById('major').value;
      data.enrollment_year = parseInt(document.getElementById('enrollment_year').value) || 0;
      data.career_interest = document.getElementById('col_career').value;
      data.bio = document.getElementById('col_bio').value;
    }

    try {
      const resp = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });
      const result = await resp.json();
      if (result.ok) {
        msgEl.textContent = '保存成功！正在跳转...';
        msgEl.className = 'profile-message success';
        setTimeout(() => { window.location.href = result.redirect; }, 800);
      } else {
        msgEl.textContent = result.message || '保存失败';
        msgEl.className = 'profile-message error';
        btn.disabled = false;
      }
    } catch (err) {
      msgEl.textContent = '网络错误，请重试。';
      msgEl.className = 'profile-message error';
      btn.disabled = false;
    }
  });
})();
</script>
