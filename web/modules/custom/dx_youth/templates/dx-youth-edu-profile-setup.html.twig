{#
 * Education profile setup — v1.0.8
 * Inline save handler so button works even if library/JS cache is stale.
 #}
<script>
(function(){
  if (!document.getElementById('edu-school-data')) {
    var url = window.location.href;
    var sep = url.indexOf('?') === -1 ? '?' : '&';
    window.location.replace(url + sep + '_v=' + Date.now());
  }
})();
</script>
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
<meta http-equiv="Pragma" content="no-cache">
<meta http-equiv="Expires" content="0">
<div class="edu-profile-setup">
  <div class="edu-profile-header">
    <h1>🎓 完善教育档案</h1>
    <p>请填写您的教育信息，以便获得个性化的学习体验。</p>
    <p style="font-size:12px;color:#999;margin-top:8px;">版本 <strong style="color:#d33;">v1.0.8</strong> | 如果功能不正常，请 <a href="javascript:location.reload(true)" style="color:#0071e3;">点击刷新</a></p>
  </div>

  <form id="edu-profile-form" class="edu-profile-form" novalidate>
    <script type="application/json" id="edu-school-data">{{ school_json|raw }}</script>

    <div class="form-group">
      <label>我是 <span class="required">*</span></label>
      <div class="tier-options">
        <label class="tier-option">
          <input type="radio" name="tier" value="k12" checked>
          <span class="tier-label">🎒 中小学生</span>
        </label>
        <label class="tier-option">
          <input type="radio" name="tier" value="highschool">
          <span class="tier-label">🔬 高中生</span>
        </label>
        <label class="tier-option">
          <input type="radio" name="tier" value="college">
          <span class="tier-label">🚀 大学生</span>
        </label>
      </div>
    </div>

    <div id="k12-fields" class="tier-fields">
      <div class="form-group">
        <label for="real_name">姓名 <span class="required">*</span></label>
        <input type="text" id="real_name" name="real_name" maxlength="64" data-edu-required="1">
      </div>
      <div class="form-group">
        <label for="school">学校 <span class="required">*</span></label>
        <div class="school-filter-row">
          <select id="school-district" class="school-filter-select"><option value="">全部区域</option></select>
          <select id="school-level" class="school-filter-select">
            <option value="">全部学段</option>
            <option value="primary">小学</option>
            <option value="middle">初中</option>
            <option value="high">高中</option>
            <option value="university">大学</option>
          </select>
        </div>
        <input type="text" id="school-search" class="school-search-input" placeholder="输入学校名称搜索..." autocomplete="off">
        <select id="school" name="school" class="school-select" size="6" data-edu-required="1" style="margin-top:0.3rem;">
          <option value="">请先选择区域和学段，或直接选择学校</option>
        </select>
        <input type="text" id="school_other" name="school_other" maxlength="128" placeholder="请输入学校名称" style="display:none; margin-top:0.5rem;">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="grade_year">年级</label>
          <select id="grade_year" name="grade_year">
            <option value="0">请选择</option>
            <option value="1">一年级</option><option value="2">二年级</option><option value="3">三年级</option>
            <option value="4">四年级</option><option value="5">五年级</option><option value="6">六年级</option>
            <option value="7">初一</option><option value="8">初二</option><option value="9">初三</option>
          </select>
        </div>
        <div class="form-group">
          <label for="class_name">班级</label>
          <input type="text" id="class_name" name="class_name" maxlength="64" placeholder="如：4 或 四（1）班">
        </div>
      </div>
      <div class="form-group">
        <label for="interests_text">兴趣爱好</label>
        <textarea id="interests_text" name="interests" rows="3" placeholder="如：阅读（哈利波特），AI/SI，长跑，越野跑，主持"></textarea>
      </div>
    </div>

    <div id="highschool-fields" class="tier-fields" style="display:none;">
      <div class="form-group">
        <label for="hs_real_name">姓名 <span class="required">*</span></label>
        <input type="text" id="hs_real_name" name="real_name" maxlength="64" data-edu-required="1">
      </div>
      <div class="form-group">
        <label for="hs_school">学校 <span class="required">*</span></label>
        <div class="school-filter-row">
          <select id="hs-school-district" class="school-filter-select"><option value="">全部区域</option></select>
          <select id="hs-school-level" class="school-filter-select">
            <option value="">全部学段</option>
            <option value="high">高中</option>
            <option value="vocational">职高/中专</option>
          </select>
        </div>
        <input type="text" id="hs-school-search" class="school-search-input" placeholder="输入学校名称搜索..." autocomplete="off">
        <select id="hs_school" name="school" class="school-select" size="6" data-edu-required="1" style="margin-top:0.3rem;">
          <option value="">请先选择区域和学段，或直接选择学校</option>
        </select>
        <input type="text" id="hs_school_other" name="hs_school_other" maxlength="128" placeholder="请输入学校名称" style="display:none; margin-top:0.5rem;">
      </div>
      <div class="form-group">
        <label for="hs_specialty">专业方向</label>
        <input type="text" id="hs_specialty" name="specialty" maxlength="64">
      </div>
      <div class="form-group">
        <label for="hs_career">职业规划</label>
        <input type="text" id="hs_career" name="career_interest" maxlength="128">
      </div>
      <div class="form-group">
        <label for="hs_interests">兴趣爱好</label>
        <textarea id="hs_interests" name="interests" rows="3" placeholder="如：物理竞赛，编程，天文"></textarea>
      </div>
    </div>

    <div id="college-fields" class="tier-fields" style="display:none;">
      <div class="form-group">
        <label for="col_real_name">姓名 <span class="required">*</span></label>
        <input type="text" id="col_real_name" name="real_name" maxlength="64" data-edu-required="1">
      </div>
      <div class="form-group">
        <label for="col_university">大学 <span class="required">*</span></label>
        <div class="school-filter-row">
          <select id="col-school-district" class="school-filter-select"><option value="">全部区域</option></select>
          <select id="col-school-level" class="school-filter-select" style="display:none;"><option value="university" selected>大学</option></select>
        </div>
        <input type="text" id="col-school-search" class="school-search-input" placeholder="输入大学名称搜索..." autocomplete="off">
        <select id="col_university" name="university" class="school-select" size="6" data-edu-required="1" style="margin-top:0.3rem;">
          <option value="">请先选择区域，或直接选择大学</option>
        </select>
        <input type="text" id="col_university_other" name="col_university_other" maxlength="128" placeholder="请输入大学名称" style="display:none; margin-top:0.5rem;">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="major">专业</label>
          <input type="text" id="major" name="major" maxlength="64">
        </div>
        <div class="form-group">
          <label for="enrollment_year">入学年份</label>
          <input type="number" id="enrollment_year" name="enrollment_year" min="2000" max="2030">
        </div>
      </div>
      <div class="form-group">
        <label for="col_career">职业规划</label>
        <input type="text" id="col_career" name="career_interest" maxlength="128">
      </div>
      <div class="form-group">
        <label for="col_bio">个人简介</label>
        <textarea id="col_bio" name="bio" rows="4"></textarea>
      </div>
    </div>

    <div id="profile-message" class="profile-message"></div>
    <button type="button" id="edu-profile-save-btn" class="edu-profile-save-btn">保存并继续</button>
  </form>
</div>

<script>
(function(){
  var form = document.getElementById('edu-profile-form');
  if (!form || form.getAttribute('data-edu-dropdowns') === '1') return;
  form.setAttribute('data-edu-dropdowns', '1');
  form.setAttribute('novalidate', 'novalidate');

  var settings = (window.drupalSettings && drupalSettings.dxYouth) || {};
  var existing = settings.existingProfile;
  var allDistricts = [], allSchools = [];
  var dataEl = document.getElementById('edu-school-data');
  if (dataEl) {
    try { var d = JSON.parse(dataEl.textContent); allDistricts = d.districts || []; allSchools = d.schools || []; } catch(e) {}
  }
  if (!allDistricts.length && settings.schoolDistricts) {
    allDistricts = settings.schoolDistricts; allSchools = settings.schoolList || [];
  }

  ['school-district','hs-school-district','col-school-district'].forEach(function(id){
    var sel = document.getElementById(id); if (!sel) return;
    allDistricts.forEach(function(di){
      var opt = document.createElement('option'); opt.value = di.id; opt.textContent = di.name; sel.appendChild(opt);
    });
  });

  function updateSchools(dId, lId, sId, searchId) {
    var sel = document.getElementById(sId); if (!sel) return;
    var dist = document.getElementById(dId).value;
    var lvl = document.getElementById(lId).value;
    var searchEl = document.getElementById(searchId);
    var keyword = searchEl ? searchEl.value.trim().toLowerCase() : '';
    sel.innerHTML = '<option value="">请选择学校</option>';
    var list = allSchools;
    if (dist) list = list.filter(function(s){return s.district===dist;});
    if (lvl) list = list.filter(function(s){return s.level===lvl;});
    if (keyword) list = list.filter(function(s){return s.name.toLowerCase().indexOf(keyword) !== -1;});
    list.forEach(function(s){ var o = document.createElement('option'); o.value = s.name; o.textContent = s.name; sel.appendChild(o); });
    var oo = document.createElement('option'); oo.value = '__other__'; oo.textContent = '其他（手动输入）'; sel.appendChild(oo);
    if (searchEl) searchEl.placeholder = list.length + ' 所学校匹配，输入继续搜索...';
  }

  function bindOther(sId, oId) {
    var s = document.getElementById(sId), inp = document.getElementById(oId);
    if (!s || !inp) return;
    s.addEventListener('change', function(){
      if (this.value === '__other__') { this.style.display='none'; inp.style.display=''; inp.focus(); }
      else { inp.style.display='none'; if(this.style.display==='none'){ this.style.display=''; } }
    });
  }

  function switchTier(t) {
    var k=document.getElementById('k12-fields'),h=document.getElementById('highschool-fields'),c=document.getElementById('college-fields');
    if(k)k.style.display=(t==='k12')?'':'none';
    if(h)h.style.display=(t==='highschool')?'':'none';
    if(c)c.style.display=(t==='college')?'':'none';
  }

  updateSchools('school-district','school-level','school','school-search');
  updateSchools('hs-school-district','hs-school-level','hs_school','hs-school-search');
  updateSchools('col-school-district','col-school-level','col_university','col-school-search');
  bindOther('school','school_other');
  bindOther('hs_school','hs_school_other');
  bindOther('col_university','col_university_other');

  if (existing) {
    var tier = existing.tier || 'k12';
    document.querySelectorAll('input[name="tier"]').forEach(function(r){ r.checked = (r.value === tier); });
    switchTier(tier);
  }

  var el;
  el = document.getElementById('school-district'); if (el) el.addEventListener('change', function(){ updateSchools('school-district','school-level','school','school-search'); });
  el = document.getElementById('school-level'); if (el) el.addEventListener('change', function(){ updateSchools('school-district','school-level','school','school-search'); });
  el = document.getElementById('hs-school-district'); if (el) el.addEventListener('change', function(){ updateSchools('hs-school-district','hs-school-level','hs_school','hs-school-search'); });
  el = document.getElementById('hs-school-level'); if (el) el.addEventListener('change', function(){ updateSchools('hs-school-district','hs-school-level','hs_school','hs-school-search'); });
  el = document.getElementById('col-school-district'); if (el) el.addEventListener('change', function(){ updateSchools('col-school-district','col-school-level','col_university','col-school-search'); });

  function bindSearch(searchId, dId, lId, sId) {
    var inp = document.getElementById(searchId); if (!inp) return;
    var timer;
    inp.addEventListener('input', function(){ clearTimeout(timer); timer = setTimeout(function(){ updateSchools(dId, lId, sId, searchId); }, 200); });
  }
  bindSearch('school-search','school-district','school-level','school');
  bindSearch('hs-school-search','hs-school-district','hs-school-level','hs_school');
  bindSearch('col-school-search','col-school-district','col-school-level','col_university');

  document.querySelectorAll('input[name="tier"]').forEach(function(r){
    r.addEventListener('change', function(){ switchTier(this.value); });
  });
  var checked = document.querySelector('input[name="tier"]:checked');
  switchTier(checked ? checked.value : 'k12');
})();
</script>

<script>
/* Inline save fallback v1.0.8 */
(function () {
  function qs(sel) { return document.querySelector(sel); }
  function getEndpoint() {
    try {
      if (window.drupalSettings && drupalSettings.dxYouth && drupalSettings.dxYouth.eduProfileEndpoint) {
        return drupalSettings.dxYouth.eduProfileEndpoint;
      }
    } catch (e) {}
    return '/dx/youth/edu-profile-save';
  }
  function getToken() {
    try {
      if (window.drupalSettings && drupalSettings.dxYouth && drupalSettings.dxYouth.csrfToken) {
        return Promise.resolve(drupalSettings.dxYouth.csrfToken);
      }
    } catch (e) {}
    return fetch('/session/token', { credentials: 'same-origin' }).then(function (r) { return r.text(); }).catch(function () { return ''; });
  }
  function showMsg(text, ok) {
    var el = qs('#profile-message');
    if (!el) { alert(text); return; }
    el.hidden = false;
    el.textContent = text;
    el.className = 'profile-message ' + (ok ? 'success' : 'error');
  }
  function collectData() {
    var tierEl = qs('input[name="tier"]:checked');
    var tier = tierEl ? tierEl.value : 'k12';
    var data = { tier: tier };
    function v(id) { var n = qs(id); return n ? (n.value || '') : ''; }
    if (tier === 'k12') {
      data.real_name = v('#real_name');
      var schoolVal = v('#school');
      data.school = schoolVal === '__other__' ? v('#school_other') : schoolVal;
      data.grade_year = parseInt(v('#grade_year'), 10) || 0;
      data.class_name = v('#class_name');
      data.interests = v('#interests_text');
    } else if (tier === 'highschool') {
      data.real_name = v('#hs_real_name');
      var hsVal = v('#hs_school');
      data.school = hsVal === '__other__' ? v('#hs_school_other') : hsVal;
      data.specialty = v('#hs_specialty');
      data.career_interest = v('#hs_career');
      data.interests = v('#hs_interests');
    } else {
      data.real_name = v('#col_real_name');
      var colVal = v('#col_university');
      data.university = colVal === '__other__' ? v('#col_university_other') : colVal;
      data.major = v('#major');
      data.enrollment_year = parseInt(v('#enrollment_year'), 10) || 0;
      data.career_interest = v('#col_career');
      data.bio = v('#col_bio');
    }
    return data;
  }
  function doSave(e) {
    if (e) { e.preventDefault(); e.stopPropagation(); }
    var btn = qs('#edu-profile-save-btn');
    if (btn) btn.disabled = true;
    showMsg('正在保存...', true);
    var data = collectData();
    if (!data.real_name) {
      showMsg('请填写姓名', false);
      if (btn) btn.disabled = false;
      return false;
    }
    getToken().then(function (token) {
      return fetch(getEndpoint(), {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': token || '' },
        body: JSON.stringify(data)
      }).then(function (res) { return res.json().catch(function () { return {}; }); });
    }).then(function (result) {
      if (result && result.ok) {
        showMsg('保存成功！正在跳转...', true);
        setTimeout(function () { window.location.href = result.redirect || '/edu'; }, 600);
      } else {
        showMsg((result && result.message) || '保存失败，请重试', false);
        if (btn) btn.disabled = false;
      }
    }).catch(function () {
      showMsg('网络错误，请重试', false);
      if (btn) btn.disabled = false;
    });
    return false;
  }
  function bind() {
    var form = qs('#edu-profile-form');
    var btn = qs('#edu-profile-save-btn');
    if (btn && !btn.getAttribute('data-inline-save')) {
      btn.setAttribute('data-inline-save', '1');
      btn.addEventListener('click', doSave, true);
    }
    if (form && !form.getAttribute('data-inline-save')) {
      form.setAttribute('data-inline-save', '1');
      form.addEventListener('submit', doSave, true);
    }
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', bind);
  else bind();
  setTimeout(bind, 300);
  setTimeout(bind, 1000);
})();
</script>
