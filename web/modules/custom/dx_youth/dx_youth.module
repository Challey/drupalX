 */
function dx_youth_preprocess_dx_youth_edu_college(array &$variables): void {
  if (\Drupal::moduleHandler()->moduleExists('dx_assets')) {
    $variables['oss_base'] = \Drupal::service('dx_assets.service')->eduBaseUrl() . '/college';
  }
  $variables['categories'] = _dx_youth_load_tier_manifest('college');
  $variables['references'] = _dx_youth_load_reference_resources('college');
}


/**
 * Prepares variables for zone exam list template.
 */
function dx_youth_preprocess_dx_youth_zone_exam_list(array &$variables): void {
  $current_user = \Drupal::currentUser();
  $variables['is_teacher'] = $current_user->hasPermission('manage youth exams');
}
