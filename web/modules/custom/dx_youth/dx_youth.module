/**
 * Implements hook_preprocess_HOOK() for dx_youth_ask.
 */
function dx_youth_preprocess_dx_youth_ask(array &$variables): void {
  if ($variables['endpoint'] === '') {
    $variables['endpoint'] = Url::fromRoute('dx_youth.api_ask')->toString();
  }
  $variables['csrf_token'] = \Drupal::csrfToken()->get(CsrfRequestHeaderAccessCheck::TOKEN_KEY);
  $variables['csrf_url'] = Url::fromRoute('system.csrftoken')->toString();
}

