/**
 * Converts basic Markdown to HTML for local education documents.
 */
function _dx_youth_markdown_to_html(string $md): string {
  $lines = explode("\n", $md);
  $html = '';
  $inList = FALSE;
  $inTable = FALSE;
  $inBlockquote = FALSE;
  $inCode = FALSE;

  foreach ($lines as $line) {
    $trimmed = trim($line);

    // Code blocks.
    if (str_starts_with($trimmed, '```')) {
      if ($inCode) {
        $html .= '</code></pre>';
        $inCode = FALSE;
      }
      else {
        $html .= '<pre><code>';
        $inCode = TRUE;
      }
      continue;
    }
    if ($inCode) {
      $html .= htmlspecialchars($line) . "\n";
      continue;
    }

    // Close list if not a list item.
    if ($inList && $trimmed !== '' && !preg_match('/^[-*]\s/', $trimmed) && !preg_match('/^\d+\.\s/', $trimmed)) {
      $html .= '</ul>';
      $inList = FALSE;
    }
    // Close table.
    if ($inTable && !str_contains($trimmed, '|')) {
      $html .= '</tbody></table>';
      $inTable = FALSE;
    }
    // Close blockquote.
    if ($inBlockquote && !str_starts_with($trimmed, '>')) {
      $html .= '</blockquote>';
      $inBlockquote = FALSE;
    }

    // Empty line.
    if ($trimmed === '') {
      continue;
    }

    // Headings.
    if (preg_match('/^(#{1,6})\s+(.+)$/', $trimmed, $m)) {
      $level = strlen($m[1]);
      $text = _dx_youth_inline_markdown($m[2]);
      $html .= "<h{$level}>{$text}</h{$level}>";
      continue;
    }

    // Blockquote.
    if (str_starts_with($trimmed, '>')) {
      if (!$inBlockquote) {
        $html .= '<blockquote>';
        $inBlockquote = TRUE;
      }
      $html .= _dx_youth_inline_markdown(ltrim($trimmed, '> ')) . '<br>';
      continue;
    }

    // Table row.
    if (str_contains($trimmed, '|')) {
      $cells = array_filter(array_map('trim', explode('|', $trimmed)));
      // Skip separator rows.
      if (preg_match('/^[-|\s:]+$/', $trimmed)) {
        continue;
      }
      if (!$inTable) {
        $html .= '<table class="edu-doc-table"><tbody>';
        $inTable = TRUE;
      }
      $html .= '<tr>';
      foreach ($cells as $cell) {
        $html .= '<td>' . _dx_youth_inline_markdown($cell) . '</td>';
      }
      $html .= '</tr>';
      continue;
    }

    // List items.
    if (preg_match('/^[-*]\s+(.+)$/', $trimmed, $m)) {
      if (!$inList) {
        $html .= '<ul>';
        $inList = TRUE;
      }
      $html .= '<li>' . _dx_youth_inline_markdown($m[1]) . '</li>';
      continue;
    }
    if (preg_match('/^\d+\.\s+(.+)$/', $trimmed, $m)) {
      if (!$inList) {
        $html .= '<ul>';
        $inList = TRUE;
      }
      $html .= '<li>' . _dx_youth_inline_markdown($m[1]) . '</li>';
      continue;
    }

    // Horizontal rule.
    if (preg_match('/^---+$/', $trimmed)) {
      $html .= '<hr>';
      continue;
    }

    // Paragraph.
    $html .= '<p>' . _dx_youth_inline_markdown($trimmed) . '</p>';
  }

  // Close any open tags.
  if ($inList) $html .= '</ul>';
  if ($inTable) $html .= '</tbody></table>';
  if ($inBlockquote) $html .= '</blockquote>';
  if ($inCode) $html .= '</code></pre>';

  return '<div class="edu-doc-content">' . $html . '</div>';
}

/**
 * Processes inline markdown: bold, italic, links, code.
 */
function _dx_youth_inline_markdown(string $text): string {
  // Inline code.
  $text = preg_replace('/`([^`]+)`/', '<code>$1</code>', $text);
  // Bold.
  $text = preg_replace('/\*\*(.+?)\*\*/', '<strong>$1</strong>', $text);
  // Italic.
  $text = preg_replace('/\*(.+?)\*/', '<em>$1</em>', $text);
  // Links.
  $text = preg_replace('/\[([^\]]+)\]\(([^)]+)\)/', '<a href="$2" target="_blank" rel="noopener">$1</a>', $text);
  // Auto-link bare URLs (http/https).
  $text = preg_replace(
    '/(?<!href=")(https?:\/\/[^\s<>\"]+)/i',
    '<a href="$1" target="_blank" rel="noopener">$1</a>',
    $text
  );
  return $text;
}



