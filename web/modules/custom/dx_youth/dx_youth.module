/**
 * Loads the OSS file manifest and returns categorized file data for a tier.
 */
function _dx_youth_load_tier_manifest(string $tier): array {
  $manifest_file = \Drupal::root() . '/modules/custom/dx_youth/config/edu-oss-manifest.json';
  $manifest = [];
  if (is_file($manifest_file)) {
    $manifest = json_decode((string) file_get_contents($manifest_file), TRUE) ?: [];
  }
  $tier_data = $manifest[$tier] ?? [];
  $labels = _dx_youth_category_labels($tier);
  $result = [];
  $assets = \Drupal::moduleHandler()->moduleExists('dx_assets') ? \Drupal::service('dx_assets.service') : NULL;
  foreach ($tier_data as $cat_key => $files) {
    $result[$cat_key] = [
      'label' => $labels[$cat_key] ?? $cat_key,
      'files' => array_map(function (string $path) use ($assets): array {
        $name = basename($path);
        $url = $assets ? $assets->previewUrl('edu/' . $path) : '';
        return ['name' => $name, 'url' => $url];
      }, $files),
    ];
  }
  return $result;
}

/**
 * Loads reference resources from edu-resources-reference.json for a tier.
 *
 * @param string $tier
 *   Tier key: autocar, drone, bci, etc.
 *
 * @return array
 *   Array of [label, resources => [[title, url, description]]].
 */
function _dx_youth_load_reference_resources(string $tier): array {
  $ref_file = \Drupal::root() . '/modules/custom/dx_youth/config/edu-resources-reference.json';
  if (!is_file($ref_file)) {
    return [];
  }
  $data = json_decode((string) file_get_contents($ref_file), TRUE) ?: [];
  $tier_data = $data[$tier] ?? [];
  $result = [];
  foreach ($tier_data as $key => $value) {
    if ($key === 'label' || $key === 'description') {
      continue;
    }
    if (is_array($value) && isset($value['label'], $value['resources'])) {
      $result[$key] = [
        'label' => $value['label'],
        'resources' => array_map(function (array $r): array {
          $url = $r['url'] ?? '';
          // If local_file is set, generate local route URL.
          if (!empty($r['local_file'])) {
            $parts = explode('/', $r['local_file']);
            if (count($parts) === 3) {
              $url = Url::fromRoute('dx_youth.edu_local_doc', [
                'section' => $parts[0],
                'subdir' => $parts[1],
                'file' => $parts[2],
              ])->toString();
            }
          }
          return [
            'title' => $r['title'] ?? '',
            'url' => $url,
            'description' => $r['description'] ?? '',
            'is_local' => !empty($r['local_file']),
          ];
        }, $value['resources']),
      ];
    }
  }
  return $result;
}

