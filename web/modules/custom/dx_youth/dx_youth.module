<?php

/**
 * @file
 * DrupalX Edu (教育开发专区) module file.
 *
 * Note: full module logic remains on the production tree; this file ensures
 * the edu profile setup page always receives the JS library and save endpoint.
 */

use Drupal\Core\Access\CsrfRequestHeaderAccessCheck;
use Drupal\Core\Render\Element;
use Drupal\Core\Url;

/**
 * Implements hook_preprocess_HOOK() for edu profile setup.
 */
function dx_youth_preprocess_dx_youth_edu_profile_setup(array &$variables): void {
  $attachments = [
    'library' => ['dx_youth/edu-profile'],
    'drupalSettings' => [
      'dxYouth' => [
        'csrfToken' => \Drupal::csrfToken()->get(CsrfRequestHeaderAccessCheck::TOKEN_KEY),
        'csrfUrl' => Url::fromRoute('system.csrftoken')->toString(),
        'eduProfileEndpoint' => Url::fromRoute('dx_youth.api_edu_profile_save')->toString(),
      ],
    ],
  ];
  if (!empty($variables['#attached']['drupalSettings']['dxYouth']) && is_array($variables['#attached']['drupalSettings']['dxYouth'])) {
    $attachments['drupalSettings']['dxYouth'] = array_merge(
      $attachments['drupalSettings']['dxYouth'],
      $variables['#attached']['drupalSettings']['dxYouth']
    );
  }
  $variables['#attached'] = Element::mergeDeep($variables['#attached'] ?? [], $attachments);
}
