<?php

/**
 * @file
 * Primary module hooks for the DrupalX youth AI zone.
 */

declare(strict_types=1);

use Drupal\Core\Access\CsrfRequestHeaderAccessCheck;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Url;

/**
 * Implements hook_help().
 */
function dx_youth_help($route_name, RouteMatchInterface $route_match): string {
  switch ($route_name) {
    case 'help.page.dx_youth':
      return '<p>' . t('Youth AI zone: AI courses, a safe AI companion, a creation studio, and a works showcase for K-12 students.') . '</p>';

    default:
      return '';
  }
}

/**
 * Implements hook_preprocess_HOOK() for edu profile setup.
 * Attach library + endpoint safely (never fatals).
 */
function dx_youth_preprocess_dx_youth_edu_profile_setup(array &$variables): void {
  try {
    if (!isset($variables['#attached'])) {
      $variables['#attached'] = [];
    }
    $variables['#attached']['library'][] = 'dx_youth/edu-profile';
    $dx = [
      'csrfToken' => \Drupal::csrfToken()->get(CsrfRequestHeaderAccessCheck::TOKEN_KEY),
      'csrfUrl' => Url::fromRoute('system.csrftoken')->toString(),
      'eduProfileEndpoint' => Url::fromRoute('dx_youth.api_edu_profile_save')->toString(),
    ];
    $existing = [];
    if (!empty($variables['#attached']['drupalSettings']['dxYouth']) && is_array($variables['#attached']['drupalSettings']['dxYouth'])) {
      $existing = $variables['#attached']['drupalSettings']['dxYouth'];
    }
    $variables['#attached']['drupalSettings']['dxYouth'] = array_merge($dx, $existing);
  }
  catch (\Throwable $e) {
    // Never break the page for attachment failures.
  }
}
