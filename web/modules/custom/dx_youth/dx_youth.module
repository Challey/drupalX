/**
 * Implements hook_help().
 */
function dx_youth_help($route_name, RouteMatchInterface $route_match): string {
  switch ($route_name) {
    case 'help.page.dx_youth':
      return '<p>' . t('Youth AI zone: AI courses, a safe AI companion, a creation studio, and a works showcase for K-12 students.') . '</p>';

    default:
      return '';
  }
}

