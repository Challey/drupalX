<?php

/**
 * @file
 * Primary module hooks for DrupalX App Store.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function dx_appstore_help($route_name, RouteMatchInterface $route_match): string {
  switch ($route_name) {
    case 'help.page.dx_appstore':
      return '<p>' . t('Browse curated Drupal modules and request installation for your tenant.') . '</p>';

    default:
      return '';
  }
}
